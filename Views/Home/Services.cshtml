@model List<GameStudioSite.Models.Service>
@{
    ViewData["Title"] = "Services";
}

<h1>Services</h1>
<p>What we can build for you.</p>

<div class="card-grid">
    @foreach (var service in Model)
    {
        <div class="card">
            <div class="card-body">
                <h3>@service.Title</h3>
                <p>@service.Description</p>
                <a class="btn" asp-controller="Contact" asp-action="Index">Contact Us</a>
            </div>
        </div>
    }
</div>