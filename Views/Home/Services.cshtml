@model List<GameStudioSite.Models.Service>
@{
    ViewData["Title"] = "Services";
    ViewData["HeroText"] = "Services";
    ViewData["HeroImage"] = "/images/header-services.jpg";
}

<h1>Services</h1>
<p>What we can build for you.</p>

<div class="card-grid">
    @foreach (var service in Model)
    {
        <a class="service-card"
           asp-controller="Home"
           asp-action="Services"
           style="--card-image: url('@service.PictureSecondary');">

            <div class="service-card-content">
                <h3>@service.Title</h3>
                <p>
                    @service.ShortDescription
                </p>
            </div>

        </a>
    }
</div>